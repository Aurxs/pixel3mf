+def _resolve_raster_replacement_regions(replacements, quantized_image, matched_rgb, mask_solid):
+    """Resolve scope once: explicit mask > source color > legacy matched color.
+
+    Source colors must never fall back to a merged LUT color, even on no match.
+    All masks refer to the original raster; later replacements win on overlap.
+    """
+    if isinstance(replacements, dict):
+        replacements = [{'matched': src, 'replacement': dst}
+                        for src, dst in replacements.items()]
+    regions = []
+    for item in replacements or []:
+        dst = item.get('replacement') or item.get('replacement_hex')
+        if not dst:
+            continue
+        mask = item.get('mask')
+        if mask is not None:
+            mask = np.asarray(mask)
+            if mask.shape != mask_solid.shape or mask.dtype != np.bool_:
+                raise ValueError('Replacement mask must be boolean and match the raster shape')
+        else:
+            source = (item.get('quantized') or item.get('quantized_hex')
+                      or item.get('source'))
+            key = source or item.get('matched') or item.get('matched_hex')
+            if not key:
+                continue
+            image = quantized_image if source else matched_rgb
+            if image is None or image.shape != matched_rgb.shape:
+                raise ValueError('Source-scoped replacement requires the original quantized raster')
+            mask = np.all(image == _hex_to_rgb_tuple(key), axis=-1)
+        regions.append({'mask': mask & mask_solid, 'replacement': dst})
+    return regions
+
