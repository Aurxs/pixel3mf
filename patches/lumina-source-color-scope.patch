index 0000000..db3e735
--- /dev/null
+++ b/tests/test_source_color_scope_regression.py
@@ -0,0 +1,140 @@
+"""Regression tests for raster scope; no model export or external fixtures."""
+import unittest
+import numpy as np
+from core.converter import _resolve_raster_replacement_regions, _apply_regions_to_raster_outputs
+from ui.callbacks import _build_full_color_region_mask
+
+class SourceColorScopeTests(unittest.TestCase):
+    def setUp(self):
+        self.matched = np.full((2, 733, 3), 255, dtype=np.uint8)
+        self.source = self.matched.copy()
+        self.source[0, :7] = [221, 224, 228]
+        self.solid = np.ones((2, 733), dtype=bool)
+        self.material = np.zeros((2, 733, 5), dtype=np.uint8)
+        self.stacks = np.array([[0,0,0,0,0], [0,0,0,3,1]], dtype=np.uint8)
+        self.record = {'quantized_hex':'#dde0e4', 'matched_hex':'#ffffff', 'replacement_hex':'#83878d'}
+
+    def apply(self, records, source=True):
+        regions = _resolve_raster_replacement_regions(records, self.source if source else None,
+                                                      self.matched, self.solid)
+        return _apply_regions_to_raster_outputs(self.matched, self.material, self.solid,
+                                                regions, lambda rgb: 1, self.stacks)
+
+    def test_seven_source_cells_do_not_expand_to_1466_matched_cells(self):
+        rgb, material = self.apply([self.record])
+        changed = np.any(rgb != self.matched, axis=-1)
+        self.assertEqual(int(changed.sum()), 7)
+        np.testing.assert_array_equal(changed, np.any(material != self.material, axis=-1))
+        np.testing.assert_array_equal(rgb[changed], np.tile([131,135,141], (7,1)))
+        np.testing.assert_array_equal(material[changed], np.tile(self.stacks[1], (7,1)))
+        np.testing.assert_array_equal(rgb[1], self.matched[1])  # protected white / face row
+
+    def test_source_alias_obeys_source_scope(self):
+        record = {'source':'#dde0e4', 'matched':'#ffffff', 'replacement':'#83878d'}
+        self.assertEqual(int(np.any(self.apply([record])[0] != self.matched, axis=-1).sum()), 7)
+
+    def test_source_no_match_does_not_fall_back(self):
+        record = dict(self.record, quantized_hex='#010203')
+        np.testing.assert_array_equal(self.apply([record])[0], self.matched)
+
+    def test_source_without_quantized_raster_fails_closed(self):
+        with self.assertRaisesRegex(ValueError, 'quantized raster'):
+            self.apply([self.record], source=False)
+
+    def test_explicit_mask_overrides_source_and_matched(self):
+        mask = np.zeros_like(self.solid); mask[0, :3] = True
+        rgb, material = self.apply([dict(self.record, mask=mask)])
+        np.testing.assert_array_equal(np.any(rgb != self.matched, axis=-1), mask)
+        np.testing.assert_array_equal(np.any(material != self.material, axis=-1), mask)
+
+    def test_empty_mask_does_not_fall_back(self):
+        np.testing.assert_array_equal(self.apply([dict(self.record, mask=np.zeros_like(self.solid))])[0], self.matched)
+
+    def test_bad_masks_rejected(self):
+        for mask in [np.zeros((1,1),dtype=bool), self.solid.astype(np.uint8)]:
+            with self.assertRaises(ValueError): self.apply([dict(self.record, mask=mask)])
+
+    def test_legacy_matched_only_and_dict_retain_global_behavior(self):
+        for records in [[{'matched_hex':'#ffffff','replacement_hex':'#83878d'}], {'#ffffff':'#83878d'}]:
+            self.assertEqual(int(np.any(self.apply(records)[0] != self.matched,axis=-1).sum()),1466)
+
+    def test_transparent_cells_are_excluded(self):
+        self.solid[0,0] = False
+        self.assertEqual(int(np.any(self.apply([self.record])[0] != self.matched,axis=-1).sum()),6)
+
+    def test_later_region_wins_without_scope_expansion(self):
+        mask=np.zeros_like(self.solid);mask[0,:2]=True
+        rgb,_=self.apply([self.record, {'mask':mask,'replacement':'#ffffff'}])
+        self.assertEqual(int(np.any(rgb != self.matched,axis=-1).sum()),5)
+
+    def test_gui_source_selection_cannot_union_matching_output_pixels(self):
+        self.matched[1,:] = [221,224,228]
+        cache={'quantized_image':self.source,'matched_rgb':self.matched,
+               'mask_solid':self.solid,'selected_quantized_hex':'#dde0e4'}
+        self.assertEqual(int(_build_full_color_region_mask(cache,'#dde0e4').sum()),7)
+
+    def test_fresh_preview_updates_material_and_undo_restores_it(self):
+        from unittest.mock import patch
+        from core.converter import update_preview_with_replacements
+        from core.image_processing import LuminaImageProcessor
+        cache = {'matched_rgb': self.matched, 'material_matrix': self.material,
+                 'quantized_image': self.source, 'mask_solid': self.solid,
+                 'color_conf': {}, 'replacement_ref_stacks': self.stacks,
+                 'replacement_lut_lab': LuminaImageProcessor._rgb_to_lab(
+                     np.array([[255,255,255],[131,135,141]], dtype=np.uint8))}
+        with patch('core.converter.render_preview', return_value=None), patch(
+                'core.converter.extract_color_palette', return_value=[]), patch(
+                'ui.palette_extension.generate_palette_html', return_value=''):
+            _, updated, _ = update_preview_with_replacements(cache, [self.record])
+            expected_rgb, expected_material = self.apply([self.record])
+            np.testing.assert_array_equal(updated['matched_rgb'], expected_rgb)
+            np.testing.assert_array_equal(updated['material_matrix'], expected_material)
+            _, restored, _ = update_preview_with_replacements(updated, [])
+            np.testing.assert_array_equal(restored['matched_rgb'], self.matched)
+            np.testing.assert_array_equal(restored['material_matrix'], self.material)
+            np.testing.assert_array_equal(cache['material_matrix'], self.material)
+
+    def test_cached_source_cannot_misinterpret_matched_color_as_source(self):
+        cache = {'quantized_image': self.source, 'matched_rgb': self.matched,
+                 'mask_solid': self.solid, 'selected_quantized_hex': '#dde0e4',
+                 'selected_matched_hex': '#ffffff'}
+        with self.assertRaisesRegex(ValueError, 'select the source color again'):
+            _build_full_color_region_mask(cache, '#ffffff')
+
+    def test_apply_rejects_stale_selection_even_with_cached_region(self):
+        from ui.callbacks import on_apply_color_replacement
+        cache = {'selected_quantized_hex': '#dde0e4',
+                 'selected_region_mask': self.solid.copy()}
+        regions, history = [], []
+        result = on_apply_color_replacement(cache, '#ffffff', '#83878d',
+                    regions, history, None, False, 4, 8, 2.5, 0)
+        self.assertIs(result[1], cache)
+        self.assertIs(result[3], regions)
+        self.assertIs(result[4], history)
+        self.assertIn('select the source color again', result[5])
+
+    def test_gui_state_uses_source_while_display_uses_matched_color(self):
+        from core.converter import _resolve_click_selection_hexes
+        cache = {'selected_quantized_hex': '#dde0e4',
+                 'selected_matched_hex': '#ffffff'}
+        display, state = _resolve_click_selection_hexes(cache, '#ffffff')
+        self.assertEqual(display, '#ffffff')
+        self.assertEqual(state, '#dde0e4')
+
+    def test_non_lut_rgb_keeps_legacy_literal_display_and_nearest_recipe(self):
+        from core.image_processing import LuminaImageProcessor
+        from scipy.spatial import KDTree
+        lut = np.array([[255,255,255],[131,135,141]], dtype=np.uint8)
+        tree = KDTree(LuminaImageProcessor._rgb_to_lab(lut))
+        regions = _resolve_raster_replacement_regions(
+            [dict(self.record, replacement_hex='#84878d')], self.source,
+            self.matched, self.solid)
+        def resolve(rgb):
+            return tree.query(LuminaImageProcessor._rgb_to_lab(np.array([rgb],dtype=np.uint8)))[1][0]
+        rgb, material = _apply_regions_to_raster_outputs(self.matched, self.material,
+                            self.solid, regions, resolve, self.stacks)
+        self.assertEqual(rgb[0,0].tolist(), [132,135,141])
+        self.assertEqual(material[0,0].tolist(), self.stacks[1].tolist())
+        self.assertNotEqual(rgb[0,0].tolist(), lut[1].tolist())
+
+if __name__ == '__main__': unittest.main()
